{
  // The build tools, run by Node 26 straight from source (type stripping).
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "target": "esnext",
    "lib": ["esnext"],
    "module": "nodenext",
    "types": ["node"],
    "rewriteRelativeImportExtensions": true
  },
  "include": ["tools", "vite.config.ts"]
}
