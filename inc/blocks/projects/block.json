{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "starwishx/projects",
  "version": "1.0.0",
  "title": "Projects carousel",
  "category": "custom-blocks",
  "icon": "portfolio",
  "description": "The latest projects as a horizontally scrolling row of cards with arrow buttons.",
  "keywords": ["projects", "carousel", "slider"],
  "textdomain": "starwishx",
  "attributes": {
    "suptitle": { "type": "string", "default": "" },
    "title": { "type": "string", "default": "" },
    "slidesCount": { "type": "integer", "default": 8 }
  },
  "supports": {
    "autoRegister": true,
    "html": false,
    "anchor": true
  },
  "example": {
    "attributes": {
      "suptitle": "From heart to heart",
      "title": "Projects",
      "slidesCount": 4
    }
  },
  "render": "file:./render.php",
  "style": "file:./build/style.css",
  "viewScriptModule": "file:./build/view.js"
}
