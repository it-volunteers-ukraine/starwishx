{
  "name": "starwishx",
  "version": "0.3.1",
  "description": "",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --watch --watch-preserve-output tools/build.ts --watch",
    "dev": "node --watch --watch-preserve-output tools/build.ts --watch",
    "build": "node tools/build.ts --prod && node tools/package.ts",
    "clean": "node tools/build.ts --clean",
    "sprite": "node tools/build-sprite.ts",
    "check": "vp check",
    "lint": "vp check && pnpm style:lint",
    "style:lint": "biome lint --error-on-warnings",
    "test": "php tests/url-policy.php",
    "i18n": "npm run i18n:pot && npm run i18n:po && npm run i18n:php && npm run i18n:mo",
    "i18n:pot": "wp i18n make-pot . languages/_themedomain.pot --domain=starwishx --exclude=production,.void,inc/blocks/*/build",
    "i18n:po": "wp i18n update-po languages/_themedomain.pot languages/uk.po",
    "i18n:php": "wp i18n make-php languages/uk.po languages",
    "i18n:mo": "wp i18n make-mo languages/uk.po languages",
    "prepare": "vp config --no-agent"
  },
  "repository": {
    "type": "git",
    "url": ""
  },
  "author": "it-volunteers.com",
  "license": "ISC",
  "homepage": "it-volunteers.com",
  "browserslist": [
    "baseline widely available"
  ],
  "engines": {
    "node": "^26.13.0"
  },
  "packageManager": "pnpm@12.18.0",
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@types/node": "^26.6.6",
    "browserslist": "^4.29.5",
    "lightningcss": "^1.33.0",
    "rolldown": "^1.3.1",
    "sass-embedded": "^1.108.1",
    "svgo": "^4.1.0",
    "vite-plus": "^1.5.1"
  }
}
