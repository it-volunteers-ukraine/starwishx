{
  "name": "wp-starter-theme",
  "version": "0.2.1",
  "description": "",
  "main": "gulpfile.js",
  "type": "module",
  "scripts": {
    "start": "gulp",
    "dev": "gulp",
    "build": "gulp build --prod",
    "clean": "gulp clean",
    "sprite": "node tools/build-sprite.mjs",
    "style:lint": "stylelint 'src/**/*.scss' --customSyntax postcss-scss",
    "style:fix": "stylelint 'src/**/*.scss' --customSyntax postcss-scss --fix",
    "i18n": "npm run i18n:pot && npm run i18n:po && npm run i18n:php && npm run i18n:mo",
    "i18n:pot": "wp i18n make-pot . languages/_themedomain.pot --domain=starwishx --exclude=production,.void",
    "i18n:po": "wp i18n update-po languages/_themedomain.pot languages/uk.po",
    "i18n:php": "wp i18n make-php languages/uk.po languages",
    "i18n:mo": "wp i18n make-mo languages/uk.po languages"
  },
  "repository": {
    "type": "git",
    "url": ""
  },
  "author": "onpoint.studio",
  "license": "ISC",
  "homepage": "onpoint.studio",
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@babel/preset-env": "^8.0.2",
    "autoprefixer": "^10.5.5",
    "babel-loader": "^10.1.1",
    "cssnano": "^9.0.3",
    "del": "^8.0.1",
    "git-rev-sync": "^3.0.2",
    "gulp": "^5.0.1",
    "gulp-changed": "^5.0.4",
    "gulp-cli": "^3.1.0",
    "gulp-fonter-fix": "^0.0.1",
    "gulp-if": "^3.0.0",
    "gulp-postcss": "^10.0.0",
    "gulp-rename": "^2.1.0",
    "gulp-replace": "^1.1.4",
    "gulp-sass": "^6.0.1",
    "gulp-sourcemaps": "^3.0.0",
    "gulp-stylelint-esm": "^4.0.0",
    "postcss-modules": "^9.0.1",
    "sass": "^1.104.0",
    "stylelint": "^17.15.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "svgo": "^4.1.0",
    "ttf2woff2": "^8.0.1",
    "vinyl-named": "^1.1.0",
    "webpack-stream": "^7.0.0",
    "yargs": "^18.1.0"
  },
  "allowScripts": {
    "@parcel/watcher@2.5.1": true,
    "es5-ext@0.10.64": true,
    "ttf2woff2@8.0.1": true
  }
}
