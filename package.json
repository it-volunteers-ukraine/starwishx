{
  "name": "starwishx",
  "version": "0.3.1",
  "description": "",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node tools/build.mjs --watch",
    "dev": "node tools/build.mjs --watch",
    "build": "node tools/build.mjs --prod && node tools/package.mjs",
    "clean": "node tools/build.mjs --clean",
    "sprite": "node tools/build-sprite.mjs",
    "check": "vp check",
    "lint": "vp check && pnpm style:lint",
    "style:lint": "stylelint '{src,inc/blocks}/**/*.scss'",
    "style:fix": "stylelint '{src,inc/blocks}/**/*.scss' --fix",
    "i18n": "npm run i18n:pot && npm run i18n:po && npm run i18n:php && npm run i18n:mo",
    "i18n:pot": "wp i18n make-pot . languages/_themedomain.pot --domain=starwishx --exclude=production,.void,inc/blocks/*/build",
    "i18n:po": "wp i18n update-po languages/_themedomain.pot languages/uk.po",
    "i18n:php": "wp i18n make-php languages/uk.po languages",
    "i18n:mo": "wp i18n make-mo languages/uk.po languages",
    "prepare": "vp config --no-agent"
  },
  "repository": {
    "type": "git",
    "url": ""
  },
  "author": "it-volunteers.com",
  "license": "ISC",
  "homepage": "it-volunteers.com",
  "browserslist": [
    "baseline widely available"
  ],
  "engines": {
    "node": ">=24.11"
  },
  "packageManager": "pnpm@12.15.0",
  "devDependencies": {
    "browserslist": "^4.29.5",
    "lightningcss": "^1.33.0",
    "rolldown": "^1.2.15",
    "sass-embedded": "^1.106.1",
    "stylelint": "^17.16.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "svgo": "^4.1.0",
    "vite-plus": "^1.4.0"
  }
}
