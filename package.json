{
  "name": "starwishx",
  "version": "0.3.1",
  "description": "",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --watch --watch-preserve-output tools/build.ts --watch",
    "dev": "node --watch --watch-preserve-output tools/build.ts --watch",
    "build": "node tools/build.ts --prod && node tools/package.ts",
    "clean": "node tools/build.ts --clean",
    "sprite": "node tools/build-sprite.ts",
    "check": "vp check",
    "typecheck": "tsc -p tsconfig.json && tsc -p src/js && tsc -p inc && tsc -p tests/ts && tsc -p tests/e2e",
    "lint": "vp check && pnpm typecheck && pnpm style:lint",
    "style:lint": "biome lint --error-on-warnings",
    "test": "vp test && pnpm test:url && pnpm test:php",
    "test:ts": "vp test",
    "test:url": "php tests/url-policy.php",
    "test:php": "php tests/php/vendor/bin/phpunit -c tests/php/phpunit.xml.dist",
    "test:e2e": "playwright test -c tests/e2e",
    "i18n": "npm run i18n:pot && npm run i18n:po && npm run i18n:php && npm run i18n:mo",
    "i18n:pot": "wp i18n make-pot . languages/_themedomain.pot --domain=starwishx --exclude=production,.void,inc/blocks/*/build",
    "i18n:po": "wp i18n update-po languages/_themedomain.pot languages/uk.po",
    "i18n:php": "wp i18n make-php languages/uk.po languages",
    "i18n:mo": "wp i18n make-mo languages/uk.po languages",
    "prepare": "vp config --no-agent"
  },
  "repository": {
    "type": "git",
    "url": ""
  },
  "author": "it-volunteers.com",
  "license": "ISC",
  "homepage": "it-volunteers.com",
  "browserslist": [
    "baseline widely available"
  ],
  "engines": {
    "node": "^26.13.1"
  },
  "packageManager": "pnpm@12.23.0+sha512.02da94ffaf133f46074322afe552f90d40b5f71ae259aefbccdacc5085b1d617e98d65e0131f5748b9b67445978ee5055d7d59a473f1eef0d504854fefcd5975",
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@wordpress/interactivity": "8.2.0",
    "browserslist": "^4.29.6",
    "lightningcss": "^1.33.0",
    "rolldown": "^1.3.3",
    "sass-embedded": "^1.108.2",
    "svgo": "^4.1.0",
    "typescript": "^7.0.2",
    "vite-plus": "catalog:"
  }
}
